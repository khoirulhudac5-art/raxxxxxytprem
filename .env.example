# Salin menjadi .env.local dan isi secara lokal. Jangan commit .env.local.
# Project URL dan publishable key dari Supabase Dashboard > Connect/API Keys.
# Jangan gunakan secret key, service-role key, atau password database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Jangan aktifkan sebelum persetujuan penulisan dan kesiapan schema CRUD.
SUPABASE_PRODUCT_CRUD_ENABLED=false
# Isi URL Supabase yang disetujui hanya setelah persetujuan.
SUPABASE_PRODUCT_CRUD_APPROVED_URL=
